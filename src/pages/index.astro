---
import { siteConfig } from '../config';
import { getFeatured, getGithubRepos, getRecentRepos } from '../lib/github';
import '../styles/global.css';

const repos = await getGithubRepos();
const featured = await getFeatured(repos);
const recent = await getRecentRepos(repos);
const fmtDate = (iso: string) => new Date(iso).toLocaleDateString('en-NG', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const linkedinVisible = siteConfig.links.linkedin.verified;
const emailVisible = Boolean(siteConfig.links.email.value) && !siteConfig.links.email.placeholder;
const live = repos.length > 0;
const syncedLabel = new Date().toLocaleDateString('en-NG', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e1113" />
    <meta name="description" content="Atunde Suleiman Shola builds and ships products and solutions end to end, combining product thinking, execution, and hands-on software development." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Atunde Suleiman Shola — I build and ship products and solutions end to end" />
    <meta property="og:description" content="Product thinking, execution, and hands-on building. Selected work by Atunde Suleiman Shola." />
    <meta property="og:url" content="https://0xdfinity.github.io/Portfolio/" />
    <title>Atunde Suleiman Shola — I build and ship products and solutions end to end</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href="#top" aria-label="Atunde Suleiman Shola, home">ATUNDE<span class="brand-dot">.</span></a>
      <nav aria-label="Main navigation">
        <a href="#work">Work</a><a href="#about">About</a><a href="#contact">Contact</a>
        <a href={siteConfig.links.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a href={siteConfig.links.x} target="_blank" rel="noreferrer">X <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="main">
      <section class="hero wrap" id="top" aria-labelledby="hero-title">
        <p class="eyebrow"><span class="status-mark" aria-hidden="true"></span> PRODUCT THINKING · HANDS-ON BUILDING</p>
        <h1 id="hero-title">{siteConfig.headline}</h1>
        <p class="hero-copy">I bring product thinking, execution, and building together, from the first problem to a shipped solution.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">View work <span aria-hidden="true">↓</span></a>
          <a class="button button-secondary" href={siteConfig.links.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-meta"><span>PRODUCT · WEB3 · SOFTWARE</span><span class="sync" data-live={live}><span class="status-mark" aria-hidden="true"></span>{live ? `Self-updating · synced ${syncedLabel}` : 'Offline copy · reconnecting'}</span></div>
      </section>

      <section class="section wrap" id="work" aria-labelledby="work-title">
        <div class="section-heading"><div><p class="eyebrow">SELECTED WORK</p><h2 id="work-title">Built around real problems.</h2></div><span class="section-index">01 / WORK</span></div>
        <div class="project-grid">
          {featured.map((project, index) => (
            <article class={`project-card ${project.name === 'edQorta' ? 'project-private' : ''}`}>
              <div class="card-top"><span class="card-number">0{index + 1}</span><span class="card-status">{project.status}</span></div>
              <h3>{project.title}</h3>
              <p class="project-problem">{project.problem}</p>
              <p class="project-description">{project.description}</p>
              <p class="contribution"><span>MY PART</span>{project.contribution}</p>
              <div class="card-link">
                {project.repo ? <a href={project.repo.html_url} target="_blank" rel="noreferrer">View repository <span aria-hidden="true">↗</span></a> : <span class="private-note">Product work, private by design</span>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section repo-section" aria-labelledby="repos-title">
        <div class="wrap">
          <div class="section-heading"><div><p class="eyebrow">GITHUB PROJECTS</p><h2 id="repos-title">Latest Build and Contributions</h2></div><a class="text-link" href={siteConfig.links.github} target="_blank" rel="noreferrer">All repositories <span aria-hidden="true">↗</span></a></div>
          <div class="commit-graph-card" aria-label="GitHub contribution activity chart">
            <img src="https://ghchart.rshah.org/0xdfinity" alt="Public GitHub contribution grid for 0xdfinity" loading="lazy" />
            <span>GITHUB CONTRIBUTION ACTIVITY</span>
          </div>
          {recent.length ? <div class="repo-list">
            {recent.map((repo) => <a class="repo-row" href={repo.html_url} target="_blank" rel="noreferrer">
              <span class="repo-main"><strong>{repo.name}</strong>{repo.readmeDescription && <span>{repo.readmeDescription}</span>}</span>
              <time datetime={repo.pushed_at}>{fmtDate(repo.pushed_at)}</time><span class="repo-arrow" aria-hidden="true">↗</span>
            </a>)}
          </div> : <p class="empty-repos">Public repositories will appear here when GitHub is reachable.</p>}
        </div>
      </section>

      <section class="section wrap about-section" id="about" aria-labelledby="about-title">
        <div class="section-heading"><div><p class="eyebrow">THE THROUGH LINE</p><h2 id="about-title">Product first. Built hands-on.</h2></div><span class="section-index">02 / ABOUT</span></div>
        <div class="about-content">
          <p class="about-copy">I started in project management, then picked up coding and smart contracts to get closer to the work itself. In web3, I’ve worked across business development and community building, helping products connect with the people who use them. Now I build products end to end, including <strong>edQorta</strong>, a real-estate platform I’m preparing to launch.</p>
          <div class="skills"><span class="eyebrow">TOOLS & PRACTICE</span><p>Solidity <i>·</i> TypeScript <i>·</i> JavaScript <i>·</i> Python <i>·</i> React <i>·</i> Node.js <i>·</i> Product Management <i>·</i> Business Development</p></div>
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title">
        <div class="wrap contact-inner"><p class="eyebrow">HAVE A GOOD PROBLEM?</p><h2 id="contact-title">Let’s build something<br />that matters.</h2><div class="contact-links">
          <a href={siteConfig.links.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          <a href={siteConfig.links.x} target="_blank" rel="noreferrer">X <span aria-hidden="true">↗</span></a>
          {linkedinVisible && <a href={siteConfig.links.linkedin.url} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>}
          {emailVisible && <a href={`mailto:${siteConfig.links.email.value}`}>Email <span aria-hidden="true">↗</span></a>}
        </div></div>
      </section>
    </main>
    <footer class="site-footer wrap"><a class="brand" href="#top">ATUNDE<span class="brand-dot">.</span></a><span>Designed to show the work. Built to keep growing.</span><span>© {new Date().getFullYear()} ATUNDE S.S.</span></footer>
  </body>
</html>
